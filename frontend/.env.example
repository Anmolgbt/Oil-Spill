# Origin of the OILTRACE backend API.
#
# Leave unset for local development: the app falls back to http://localhost:8000,
# which is where run_demo.sh starts uvicorn.
#
# Set it when the API and the dashboard are not on the same host — a deployed
# demo, a tunnel, or a machine other than the one serving the frontend.
VITE_API_URL=http://localhost:8000
